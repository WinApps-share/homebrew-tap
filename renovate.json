{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard"
  ],
  "homebrew": {
    "enabled": true
  },
  "schedule": ["every weekend"],
  "timezone": "Asia/Shanghai",
  "packageRules": [
    {
      "description": "Homebrew formula 与 cask 的版本更新（自动开 PR 更新 version/url/sha256）",
      "matchManagers": ["homebrew"],
      "automerge": false
    }
  ],
  "labels": ["dependencies"]
}
